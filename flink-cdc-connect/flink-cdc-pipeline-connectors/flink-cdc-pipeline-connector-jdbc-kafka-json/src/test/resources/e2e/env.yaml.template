# E2E environment template: MySQL/TiDB (source), Doris (sink), Kafka (the canal-json
# topic TiCDC writes to), and the verification timings.
#
# This file holds placeholders only. Copy it to `env.yaml` next to it and fill in the real
# endpoints and credentials; `env.yaml` is git-ignored and must never be committed.
#
#   cp src/test/resources/e2e/env.yaml.template src/test/resources/e2e/env.yaml
#
# Or keep the real values outside the repository and point the e2e.config system property
# at that file (or a classpath resource):
#
#   mvn test -Dtest=DorisE2ETest -De2e.config=file:///D:/envs/custom-env.yaml
#
# Tests that need this configuration skip themselves when it is absent; the runnable
# examples (DorisSinkExample, KafkaJsonTidbTest) fail with a message saying how to create it.

mysql:
  host: "127.0.0.1"
  port: 4000
  user: "root"
  password: "changeme"
  database: "test"

doris:
  feHttp: "127.0.0.1:8030"
  queryHost: "127.0.0.1"
  queryPort: 9030
  user: "root"
  password: "changeme"
  database: "test_doris"

kafka:
  servers: "127.0.0.1:9092"
  group: "e2e-test-group"
  topic: "topic_ticdc_test"

timing:
  # the pause between Doris verification attempts
  pollIntervalMs: 10000
  # how long each verification step waits in total before failing
  pollTimeoutMs: 300000
